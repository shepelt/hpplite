From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Won Beom Kim <shepelt@gmail.com>
Date: Tue, 27 Oct 2026 14:10:50 +0900
Subject: [PATCH] core: add sqlite3_close_hook()

Register a callback invoked at the start of sqlite3Close(), before any
teardown, so an extension can flush state while the connection is still
fully usable. Mirrors sqlite3_rollback_hook() in shape (mutex, API armor,
returns the previous pArg).

This is the only change HPPLite makes to SQLite core; everything else
lives in ext/hpplite/. Kept as a standalone commit at the bottom of the
branch so it can be rebased onto each upstream release tag with a single
potential conflict point. Exported as ext/hpplite/patches/.
---
 src/main.c      | 30 ++++++++++++++++++++++++++++++
 src/sqlite.h.in | 28 ++++++++++++++++++++++++++++
 src/sqliteInt.h |  2 ++
 3 files changed, 60 insertions(+)

diff --git a/src/main.c b/src/main.c
index c7642d413a..2d83d64ec7 100644
--- a/src/main.c
+++ b/src/main.c
@@ -1298,6 +1298,11 @@ static int sqlite3Close(sqlite3 *db, int forceZombie){
     db->trace.xV2(SQLITE_TRACE_CLOSE, db->pTraceArg, db, 0);
   }
 
+  /* Invoke the close hook before any cleanup begins */
+  if( db->xCloseCallback ){
+    db->xCloseCallback(db->pCloseArg, db);
+  }
+
   /* Force xDisconnect calls on all virtual tables */
   disconnectAllVtab(db);
 
@@ -2440,6 +2445,31 @@ void *sqlite3_rollback_hook(
   return pRet;
 }
 
+/*
+** Register a callback to be invoked just before a database connection
+** is closed. This allows extensions to perform cleanup operations.
+*/
+void *sqlite3_close_hook(
+  sqlite3 *db,                        /* Attach the hook to this database */
+  void (*xCallback)(void*, sqlite3*), /* Callback function */
+  void *pArg                          /* Argument to the function */
+){
+  void *pRet;
+
+#ifdef SQLITE_ENABLE_API_ARMOR
+  if( !sqlite3SafetyCheckOk(db) ){
+    (void)SQLITE_MISUSE_BKPT;
+    return 0;
+  }
+#endif
+  sqlite3_mutex_enter(db->mutex);
+  pRet = db->pCloseArg;
+  db->xCloseCallback = xCallback;
+  db->pCloseArg = pArg;
+  sqlite3_mutex_leave(db->mutex);
+  return pRet;
+}
+
 #ifdef SQLITE_ENABLE_PREUPDATE_HOOK
 /*
 ** Register a callback to be invoked each time a row is updated,
diff --git a/src/sqlite.h.in b/src/sqlite.h.in
index 38432a75b0..6e922d37fb 100644
--- a/src/sqlite.h.in
+++ b/src/sqlite.h.in
@@ -7211,6 +7211,34 @@ sqlite3_stmt *sqlite3_next_stmt(sqlite3 *pDb, sqlite3_stmt *pStmt);
 void *sqlite3_commit_hook(sqlite3*, int(*)(void*), void*);
 void *sqlite3_rollback_hook(sqlite3*, void(*)(void *), void*);
 
+/*
+** CAPI3REF: Close Notification Callback
+** METHOD: sqlite3
+**
+** ^The sqlite3_close_hook() interface registers a callback function
+** to be invoked just before a database connection is closed. This allows
+** extensions to perform cleanup operations before the connection is
+** destroyed.
+**
+** ^The callback function receives two arguments: the database connection
+** pointer and the pArg pointer that was passed to sqlite3_close_hook().
+**
+** ^Any callback set by a previous call to sqlite3_close_hook() for the
+** same database connection is overridden.
+**
+** ^The sqlite3_close_hook(D,C,P) function returns the P argument from
+** the previous call on the same [database connection] D, or NULL for
+** the first call on D.
+**
+** ^The close hook callback is invoked before any cleanup occurs, so the
+** database connection is still fully functional when the callback runs.
+** The callback should not call sqlite3_close() or sqlite3_close_v2() on
+** the same connection.
+**
+** See also [sqlite3_commit_hook()], [sqlite3_rollback_hook()].
+*/
+void *sqlite3_close_hook(sqlite3*, void(*)(void*, sqlite3*), void*);
+
 /*
 ** CAPI3REF: Autovacuum Compaction Amount Callback
 ** METHOD: sqlite3
diff --git a/src/sqliteInt.h b/src/sqliteInt.h
index 141ac1088a..ea9384633c 100644
--- a/src/sqliteInt.h
+++ b/src/sqliteInt.h
@@ -1763,6 +1763,8 @@ struct sqlite3 {
   int (*xCommitCallback)(void*);    /* Invoked at every commit. */
   void *pRollbackArg;               /* Argument to xRollbackCallback() */
   void (*xRollbackCallback)(void*); /* Invoked at every commit. */
+  void *pCloseArg;                  /* Argument to xCloseCallback() */
+  void (*xCloseCallback)(void*, sqlite3*); /* Invoked before close. */
   void *pUpdateArg;
   void (*xUpdateCallback)(void*,int, const char*,const char*,sqlite_int64);
   void *pAutovacPagesArg;           /* Client argument to autovac_pages */
